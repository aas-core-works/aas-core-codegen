<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://dummy.com" elementFormDefault="qualified" targetNamespace="https://dummy.com">
  <xs:group name="first">
    <xs:sequence>
      <xs:group ref="item"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="item">
    <xs:sequence>
      <xs:element name="texts">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="v" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="count" type="xs:long"/>
      <xs:element name="kind" type="kind_t" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="item_choice">
    <xs:choice>
      <xs:element name="first" type="first_t"/>
      <xs:element name="second" type="second_t"/>
    </xs:choice>
  </xs:group>
  <xs:group name="second">
    <xs:sequence>
      <xs:group ref="item"/>
      <xs:element name="note" type="xs:string"/>
    </xs:sequence>
  </xs:group>
  <xs:simpleType name="kind_t">
    <xs:restriction base="xs:string">
      <xs:enumeration value="alpha"/>
      <xs:enumeration value="beta"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="first_t">
    <xs:sequence>
      <xs:group ref="first"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="item_t">
    <xs:sequence>
      <xs:group ref="item"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="second_t">
    <xs:sequence>
      <xs:group ref="second"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="first" type="first_t"/>
  <xs:element name="second" type="second_t"/>
</xs:schema>
