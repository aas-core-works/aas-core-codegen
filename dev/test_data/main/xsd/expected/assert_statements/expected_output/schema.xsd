<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://dummy.com" elementFormDefault="qualified" targetNamespace="https://dummy.com">
  <xs:group name="childA">
    <xs:sequence>
      <xs:group ref="parent"/>
      <xs:element name="aOnly" type="xs:long"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="childB">
    <xs:sequence>
      <xs:group ref="parent"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="parent">
    <xs:sequence>
      <xs:element name="number" type="xs:long"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="parent_choice">
    <xs:choice>
      <xs:element name="childA" type="childA_t"/>
      <xs:element name="childB" type="childB_t"/>
    </xs:choice>
  </xs:group>
  <xs:group name="something">
    <xs:sequence>
      <xs:element name="number" type="xs:long"/>
