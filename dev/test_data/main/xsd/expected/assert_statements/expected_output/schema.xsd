      </xs:element>
      <xs:element name="optionalText" type="xs:string" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:group>
  <xs:complexType name="childA_t">
    <xs:sequence>
      <xs:group ref="childA"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="childB_t">
    <xs:sequence>
      <xs:group ref="childB"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="parent_t">
    <xs:sequence>
      <xs:group ref="parent"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="something_t">
    <xs:sequence>
      <xs:group ref="something"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="something" type="something_t"/>
