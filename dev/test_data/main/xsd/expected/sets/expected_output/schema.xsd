  <xs:group name="something">
    <xs:sequence>
      <xs:element name="text" type="xs:string"/>
      <xs:element name="number" type="xs:long"/>
      <xs:element name="kind" type="kind_t"/>
      <xs:element name="texts">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="v" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="numbers">
        <xs:complexType>
          <xs:sequence>
