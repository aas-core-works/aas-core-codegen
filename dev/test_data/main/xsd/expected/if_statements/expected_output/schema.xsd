<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://dummy.com" elementFormDefault="qualified" targetNamespace="https://dummy.com">
  <xs:group name="item">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="optionalText" type="xs:string" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:group>
  <xs:group name="something">
    <xs:sequence>
      <xs:element name="kind" type="kind_t"/>
      <xs:element name="text" type="xs:string"/>
      <xs:element name="number" type="xs:long"/>
      <xs:element name="flag" type="xs:boolean"/>
      <xs:element name="item" type="item_t"/>
    </xs:sequence>
  </xs:group>
  <xs:simpleType name="kind_t">
    <xs:restriction base="xs:string">
      <xs:enumeration value="alpha"/>
      <xs:enumeration value="beta"/>
      <xs:enumeration value="gamma"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="item_t">
    <xs:sequence>
      <xs:group ref="item"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="something_t">
    <xs:sequence>
      <xs:group ref="something"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="something" type="something_t"/>
</xs:schema>
