{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "DummyForTest",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/definitions/Something"
    }
  ],
  "$id": "https://dummy.com",
  "definitions": {
    "ChildA": {
      "allOf": [
        {
          "$ref": "#/definitions/Parent"
        },
        {
          "properties": {
            "aOnly": {
              "type": "integer"
            },
            "modelType": {
              "const": "ChildA"
            }
          },
          "required": [
            "aOnly"
          ]
        }
      ]
    },
    "ChildB": {
      "allOf": [
        {
          "$ref": "#/definitions/Parent"
        },
        {
          "properties": {
            "bOnly": {
              "type": "integer"
            },
            "modelType": {
              "const": "ChildB"
            }
          },
          "required": [
            "bOnly"
          ]
        }
      ]
    },
    "Container": {
      "allOf": [
        {
          "$ref": "#/definitions/Parent"
        },
        {
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Parent_choice"
              }
            },
            "modelType": {
              "const": "Container"
            }
          }
        }
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "optionalText": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "alpha",
        "beta",
        "gamma"
      ]
    },
    "ModelType": {
      "type": "string",
      "enum": [
        "ChildA",
        "ChildB",
        "Container"
      ]
    },
    "Parent": {
      "type": "object",
      "properties": {
        "optionalText": {
          "type": "string"
        },
        "modelType": {
          "$ref": "#/definitions/ModelType"
        }
      },
      "required": [
        "modelType"
      ]
    },
    "Parent_choice": {
      "oneOf": [
        {
          "$ref": "#/definitions/ChildA"
        },
        {
          "$ref": "#/definitions/ChildB"
        },
        {
          "$ref": "#/definitions/Container"
        }
      ]
    },
    "Something": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/Kind"
        },
        "text": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "flag": {
          "type": "boolean"
        },
        "item": {
          "$ref": "#/definitions/Item"
        },
        "optionalParent": {
          "$ref": "#/definitions/Parent_choice"
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Parent_choice"
          }
        }
      },
      "required": [
        "kind",
        "text",
        "number",
        "flag",
        "item"
      ]
    }
  }
}