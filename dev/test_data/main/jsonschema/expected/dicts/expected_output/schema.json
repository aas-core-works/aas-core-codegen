{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "title": "DummyForTest",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/definitions/Something"
    }
  ],
  "$id": "https://dummy.com",
  "definitions": {
    "Item": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Kind": {
      "type": "string",
      "enum": [
        "alpha",
        "beta",
        "gamma"
      ]
    },
    "ModelType": {
      "type": "string",
      "enum": []
    },
    "Something": {
      "type": "object",
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numbers": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Kind"
          }
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Item"
          }
        },
        "optionalTexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "texts",
        "numbers",
        "kinds",
        "codes",
        "items"
      ]
    }
  }
}